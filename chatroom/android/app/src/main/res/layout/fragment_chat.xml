<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0">

    <!-- 聊天消息 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- 整个输入区，高度由拖拽 handle 调整；最大化时撑满全屏 -->
    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部 handle 行：spinner | 拖拽标签(可拖) | maximize 按钮 -->
        <LinearLayout
            android:id="@+id/handleRow"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#F5F5F5"
            android:elevation="4dp"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinnerInputMode"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:minWidth="56dp"
                android:layout_marginEnd="4dp"
                android:background="@null"
                android:dropDownWidth="160dp" />

            <!-- "拖拽" 标签 = 拖拽热区；宽高都占满中段 -->
            <TextView
                android:id="@+id/handleLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:gravity="center"
                android:text="拖拽"
                android:textSize="12sp"
                android:textColor="#999999"
                android:background="@drawable/bg_drag_handle" />

            <TextView
                android:id="@+id/btnMaximize"
                android:layout_width="88dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:text="⤢ 全屏"
                android:textSize="13sp"
                android:textColor="#2196F3"
                android:background="@drawable/bg_remote_btn"
                android:contentDescription="最大化输入区" />

        </LinearLayout>

        <!-- 5 种 inputBar 装在 FrameLayout，可见那个 MATCH_PARENT 撑满 handle 之下 -->
        <FrameLayout
            android:id="@+id/visibleInputBar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 文字模式 -->
            <LinearLayout
                android:id="@+id/inputBarText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/editInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:hint="输入消息..."
                    android:inputType="textMultiLine"
                    android:maxLines="6"
                    android:gravity="top"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textColor="#000000"
                    android:textColorHint="#999999" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发送"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#2196F3" />

            </LinearLayout>

            <!-- 遥控器模式：方向键 + 数字键 -->
            <LinearLayout
                android:id="@+id/inputBarRemote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:visibility="gone">

                <GridLayout
                    android:id="@+id/remoteGrid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:padding="2dp">

                    <TextView android:id="@+id/btnRemoteUpLeft"    android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="q" android:textSize="20sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnRemoteUp"        android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="w" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnRemoteUpRight"   android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="e" android:textSize="20sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />

                    <TextView android:id="@+id/btnRemoteLeft"      android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="a" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnRemoteCenter"    android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="s" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnRemoteRight"     android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="d" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />

                    <TextView android:id="@+id/btnRemoteDownLeft"  android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="z" android:textSize="20sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnRemoteDown"      android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="x" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnRemoteDownRight" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="c" android:textSize="20sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />

                </GridLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#CCCCCC"
                    android:layout_marginHorizontal="6dp" />

                <GridLayout
                    android:id="@+id/numPadGrid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:padding="2dp">

                    <TextView android:id="@+id/btnNum1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="1" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnNum2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="2" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnNum3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="3" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />

                    <TextView android:id="@+id/btnNum4" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="4" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnNum5" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="5" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnNum6" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="6" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />

                    <TextView android:id="@+id/btnNum7" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="7" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnNum8" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="8" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />
                    <TextView android:id="@+id/btnNum9" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:gravity="center" android:text="9" android:textSize="22sp" android:textColor="#333333" android:background="@drawable/bg_remote_btn" />

                </GridLayout>

            </LinearLayout>

            <!-- 三维模式 -->
            <LinearLayout
                android:id="@+id/inputBarDim3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/leftSideDim3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/btnDim3Up"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_remote_btn_solid" />

                    <LinearLayout
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center">
                            <TextView android:id="@+id/btnDim3UpLeft"    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↖" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                            <TextView android:id="@+id/btnDim3Up2"      android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↑" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                            <TextView android:id="@+id/btnDim3UpRight" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↗" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center">
                            <TextView android:id="@+id/btnDim3Left"    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="←" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                            <TextView android:id="@+id/btnDim3Center" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◉" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                            <TextView android:id="@+id/btnDim3Right"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="→" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center">
                            <TextView android:id="@+id/btnDim3DownLeft"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↙" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                            <TextView android:id="@+id/btnDim3Down"      android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↓" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                            <TextView android:id="@+id/btnDim3DownRight" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↘" android:textSize="24sp" android:textColor="#2196F3" android:background="@drawable/bg_remote_btn" />
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnDim3DownBtn"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="-"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_remote_btn_solid" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="0dp"
                    android:background="#CCCCCC" />

                <com.example.chatroom.ui.common.AxisView
                    android:id="@+id/axisViewDim3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- 语音模式（TODO） -->
            <LinearLayout
                android:id="@+id/inputBarVoice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="语音模式（TODO）"
                    android:textColor="#999999"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 文件模式（TODO） -->
            <LinearLayout
                android:id="@+id/inputBarFile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文件模式（TODO）"
                    android:textColor="#999999"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 空白内容模式：inputArea 宽×高 实时显示 -->
            <LinearLayout
                android:id="@+id/inputBarEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0dp × 0dp"
                    android:textSize="18sp"
                    android:textColor="#666666" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
