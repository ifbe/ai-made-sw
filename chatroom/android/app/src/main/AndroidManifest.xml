<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 录音（语音输入 mode 用，固定 PCM 16 kHz / mono / 16-bit） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 前台服务（保活 TCP 连接） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- connectedDevice 类型要求"设备权限"至少一个，TCP 网络通信对应这个 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.App">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|navigation|density|fontScale|layoutDirection"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 承载 TCP 连接的前台服务：仅当存在 TCP participant 时启动，全部断开后自停 -->
        <service
            android:name=".service.TcpForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <!-- 全屏图片查看：聊天消息图片气泡点进来，单击任意位置退出 -->
        <activity
            android:name=".ui.chat.FullscreenImageActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|navigation|density|fontScale|layoutDirection"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="false" />
    </application>

</manifest>
