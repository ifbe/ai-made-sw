<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:fitsSystemWindows="false">

    <!-- 朝上指向云端的箭头 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="↑ 云端 ↑"
        android:textAlignment="center"
        android:textSize="8sp"
        android:textColor="#000"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"/>

    <!-- 区域1：服务器设置 + 双向数据预览 (红色系) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFE4E4"
        android:padding="4dp"
        android:layout_margin="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 区域1: RTMP/RTSP 双向交互"
            android:textStyle="bold"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <Spinner
                android:id="@+id/spinner_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/protocols"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="://"
                android:textSize="10sp"/>
            <EditText
                android:id="@+id/et_server_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="服务器地址"
                android:text="192.168.5.213"
                android:textSize="10sp"
                android:padding="4dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="10sp"/>
            <EditText
                android:id="@+id/et_port"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:hint="端口"
                android:text="1935"
                android:textSize="10sp"
                android:padding="4dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"/>
            <EditText
                android:id="@+id/et_app_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="应用/流名"
                android:text="/live/test"
                android:textSize="10sp"
                android:padding="4dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="交互数据包预览"
            android:textStyle="bold"
            android:textSize="9sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="2dp"/>

        <com.example.pusher.ui.PreviewLogView
            android:id="@+id/preview_rtmp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFF0F0"
            android:padding="2dp"/>
    </LinearLayout>

    <!-- 从封装到 RTMP 的箭头 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="↑ 封装 → RTMP ↑"
        android:textAlignment="center"
        android:textSize="8sp"
        android:textColor="#000"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"/>

    <!-- 区域2：封装设置 + FLV/fMP4 数据预览 (橙色系) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFF4E0"
        android:padding="4dp"
        android:layout_margin="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 区域2: 封装层 (FLV/fMP4)"
            android:textStyle="bold"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp"/>

        <Spinner
            android:id="@+id/spinner_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/formats"
            android:layout_marginTop="2dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="封装数据预览"
            android:textStyle="bold"
            android:textSize="9sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="2dp"/>

        <com.example.pusher.ui.PreviewLogView
            android:id="@+id/preview_mux"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFF8F0"
            android:padding="2dp"/>
    </LinearLayout>

    <!-- 从视频码流/音频码流到封装的箭头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="2dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="视频码流->封装 ↑"
            android:textAlignment="center"
            android:textSize="8sp"
            android:textColor="#000"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="音频码流->封装 ↑"
            android:textAlignment="center"
            android:textSize="8sp"
            android:textColor="#000"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>

    <!-- 区域3+4：中下区域，左右并排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_margin="1dp">

        <!-- 区域3：中下-左 视频编码设置 + 视频码流预览 (绿色系) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#E8F5E9"
            android:padding="4dp"
            android:layout_marginEnd="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 视频编码"
                android:textStyle="bold"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="编码器:"
                    android:textSize="9sp"/>
                <Spinner
                    android:id="@+id/spinner_video_codec"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="码率:"
                    android:textSize="9sp"/>
                <EditText
                    android:id="@+id/et_video_bitrate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2500"
                    android:textSize="9sp"
                    android:padding="2dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kbps"
                    android:textSize="8sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="帧率:"
                    android:textSize="9sp"/>
                <EditText
                    android:id="@+id/et_video_fps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="30"
                    android:textSize="9sp"
                    android:padding="2dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="fps"
                    android:textSize="8sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频码流预览"
                android:textStyle="bold"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="2dp"/>

            <com.example.pusher.ui.PreviewLogView
                android:id="@+id/preview_video"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#F1F8E9"
                android:padding="2dp"/>
        </LinearLayout>

        <!-- 区域4：中下-右 音频编码设置 + 音频码流预览 (蓝色系) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#E3F2FD"
            android:padding="4dp"
            android:layout_marginStart="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵 音频编码"
                android:textStyle="bold"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="编码器:"
                    android:textSize="9sp"/>
                <Spinner
                    android:id="@+id/spinner_audio_codec"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="码率:"
                    android:textSize="9sp"/>
                <EditText
                    android:id="@+id/et_audio_bitrate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="128"
                    android:textSize="9sp"
                    android:padding="2dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kbps"
                    android:textSize="8sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="采样率:"
                    android:textSize="9sp"/>
                <EditText
                    android:id="@+id/et_audio_samplerate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="44.1"
                    android:textSize="9sp"
                    android:padding="2dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kHz"
                    android:textSize="8sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音频码流预览"
                android:textStyle="bold"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="2dp"/>

            <com.example.pusher.ui.PreviewLogView
                android:id="@+id/preview_audio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#F0F8FF"
                android:padding="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 从预览到编码的箭头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="2dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="视频->码流 ↑"
            android:textAlignment="center"
            android:textSize="8sp"
            android:textColor="#000"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="音频->码流 ↑"
            android:textAlignment="center"
            android:textSize="8sp"
            android:textColor="#000"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>

    <!-- 区域5+6：底部区域，左右并排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_margin="1dp">

        <!-- 区域5：底部-左 视频设备设置 + 视频预览 (紫色系) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#F3E5F5"
            android:padding="4dp"
            android:layout_marginEnd="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 视频采集"
                android:textStyle="bold"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="相机:"
                    android:textSize="9sp"/>
                <Spinner
                    android:id="@+id/spinner_camera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分辨率:"
                    android:textSize="9sp"/>
                <Spinner
                    android:id="@+id/spinner_resolution"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频预览"
                android:textStyle="bold"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="2dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#000000"
                android:gravity="center">

                <TextureView
                    android:id="@+id/texture_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">
                </TextureView>
            </FrameLayout>
        </LinearLayout>

        <!-- 区域6：底部-右 音频设备设置 + 音频波形预览 (粉色系) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFE0F0"
            android:padding="4dp"
            android:layout_marginStart="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ 音频采集"
                android:textStyle="bold"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="麦克风:"
                    android:textSize="9sp"/>
                <Spinner
                    android:id="@+id/spinner_mic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="声道:"
                    android:textSize="9sp"/>
                <Spinner
                    android:id="@+id/spinner_channels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音频波形预览"
                android:textStyle="bold"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="2dp"/>

            <com.example.pusher.ui.AudioWaveformView
                android:id="@+id/waveform_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFF0F8"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 从预览到编码的箭头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="视频预览 ↑"
            android:textAlignment="center"
            android:textSize="8sp"
            android:textColor="#000"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="音频预览 ↑"
            android:textSize="8sp"
            android:textAlignment="center"
            android:textColor="#000"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>

    <!-- 控制按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_marginTop="2dp">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ 开始推流"
            android:textSize="11sp"
            android:padding="6dp"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏹ 停止推流"
            android:textSize="11sp"
            android:padding="6dp"
            android:background="#F44336"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>